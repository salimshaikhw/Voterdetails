# Environment Configuration
# Copy this file to .env and update with your actual values

# API Base URL (use full URL for production, or "/api" for relative proxy)
# For production: http://your-api-server.com/api
# For local proxy: /api (uses vite.config.js proxy)
VITE_API_BASE_URL=/api

# API Base URL for development server proxy (optional)
# VITE_DEV_API_BASE_URL=http://localhost:5196

# Application environment
VITE_APP_ENV=production

# Enable/disable features
# VITE_ENABLE_ANALYTICS=true
# VITE_ENABLE_DEBUG=false
